# ==============================================================================
# No5ocial Backend Environment Configuration Template
# 
# SECURITY WARNING:
# NEVER commit real tokens, keys, passwords, or credentials to version control.
# Copy this file to `.env` on your secure server or inject via a secret manager.
# ==============================================================================

# Server & Runtime Environment
ENVIRONMENT=development # development | staging | production
PORT=8080
LOG_LEVEL=info # debug | info | warn | error
APP_TIMEZONE=Asia/Kolkata # Default presentation timezone (DB persists in UTC)

# Database Connection (Supabase / PostgreSQL)
# Timestamps must always be handled in UTC
DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@[DB_HOST]:5432/no5ocial
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[REDACTED_SERVER_ONLY_SERVICE_ROLE_KEY]
SUPABASE_JWT_SECRET=[REDACTED_JWT_SECRET]

# Token Vault Encryption (AES-256-GCM Key for encrypting OAuth tokens at rest)
TOKEN_VAULT_ENCRYPTION_KEY=[32_BYTE_HEX_ENCRYPTION_KEY_PLACEHOLDER]

# Storage (S3 / Supabase Storage Bucket for Media)
STORAGE_BUCKET_NAME=no5ocial-media-staging
STORAGE_ENDPOINT=https://[PROJECT_REF].supabase.co/storage/v1
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900 # 15 minutes max for provider ingestion

# ------------------------------------------------------------------------------
# Provider OAuth Apps & Secrets (Server-Side ONLY)
# Never inject these into client builds or Flutter assets.
# ------------------------------------------------------------------------------

# Meta / Instagram Graph API
# Requires: Business/Creator IG account connected to a Facebook Page
META_APP_ID=[META_APP_ID_PLACEHOLDER]
META_APP_SECRET=[META_APP_SECRET_PLACEHOLDER]
META_REDIRECT_URI=https://api.yourdomain.com/auth/callback/meta
META_WEBHOOK_VERIFY_TOKEN=[META_WEBHOOK_VERIFY_TOKEN_PLACEHOLDER]

# Google Cloud / YouTube Data API v3
GOOGLE_CLIENT_ID=[GOOGLE_CLIENT_ID_PLACEHOLDER]
GOOGLE_CLIENT_SECRET=[GOOGLE_CLIENT_SECRET_PLACEHOLDER]
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/callback/google

# LinkedIn Developer Platform
# Community Management API / Share on LinkedIn
LINKEDIN_CLIENT_ID=[LINKEDIN_CLIENT_ID_PLACEHOLDER]
LINKEDIN_CLIENT_SECRET=[LINKEDIN_CLIENT_SECRET_PLACEHOLDER]
LINKEDIN_REDIRECT_URI=https://api.yourdomain.com/auth/callback/linkedin

# X (Twitter) Developer API v2
# Warning: Free tier has strict limits; Basic tier is $100/mo. Use manual handoff if unapproved.
X_CLIENT_ID=[X_CLIENT_ID_PLACEHOLDER]
X_CLIENT_SECRET=[X_CLIENT_SECRET_PLACEHOLDER]
X_REDIRECT_URI=https://api.yourdomain.com/auth/callback/x
X_API_MONTHLY_BUDGET_USD=0 # Set kill switch limit; 0 enforces manual handoff

# ------------------------------------------------------------------------------
# Queue & Publishing Worker Settings
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
WORKER_JOB_LOCK_TIMEOUT_SECONDS=300
MAX_JOB_RETRIES=3
JOB_RETRY_BACKOFF_BASE_SECONDS=10
