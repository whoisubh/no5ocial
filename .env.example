# ==============================================================================
# no5ocial Root / Frontend Environment Configuration Template
#
# SECURITY INSTRUCTION:
# 1. Copy this file to `.env` (which is ignored by .gitignore).
# 2. Never commit real secrets, private keys, or tokens to version control.
# 3. Use `--dart-define-from-file=.env` or `--dart-define=KEY=VALUE` when running Flutter.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client IDs
# ------------------------------------------------------------------------------
# Web Client ID (Registered in Google Cloud Console as Web Application)
# Required for Flutter Web & as serverClientId on Android for backend token exchange.
GOOGLE_WEB_CLIENT_ID=1030532523858-o2o0l8c04r7jqdqn8d36ulkafonfafui.apps.googleusercontent.com

# Android Client ID (Registered in Google Cloud Console as Android)
# Tied to package: com.shaadow.no5ocial and your keystore SHA-1.
GOOGLE_ANDROID_CLIENT_ID=1030532523858-cclggq2pqcuqdntibtvt7mmftsoqie2a.apps.googleusercontent.com

# Generic alias fallback
GOOGLE_CLIENT_ID=1030532523858-o2o0l8c04r7jqdqn8d36ulkafonfafui.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Instagram / Meta OAuth Configuration (Backend / Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Found under: Meta Developer Dashboard > Use Cases > Instagram > API setup with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://no5ocial.vercel.app/api/auth/callback/instagram

# ------------------------------------------------------------------------------
# LinkedIn OAuth 2.0 Configuration (Backend / Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Found under: LinkedIn Developer Portal > Your App > Auth > Application credentials
# Products required: "Share on LinkedIn", "Sign In with LinkedIn using OpenID Connect", "Community Management API" (for pages)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://no5ocial.vercel.app/api/auth/callback/linkedin

# ------------------------------------------------------------------------------
# X (Twitter) API v2 Configuration (Backend / Vercel Environment Variables)
# ------------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://no5ocial.vercel.app/api/auth/callback/x

# ------------------------------------------------------------------------------
# Meta Threads API Configuration (Backend / Vercel Environment Variables)
# ------------------------------------------------------------------------------
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://no5ocial.vercel.app/api/auth/callback/threads

# ------------------------------------------------------------------------------
# Google Cloud / YouTube Data API v3 (Backend / Vercel Environment Variables)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://no5ocial.vercel.app/api/auth/callback/google

# ------------------------------------------------------------------------------
# Cloudflare R2 Object Storage (Backend / Vercel Environment Variables)
# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# Branded Application Web Domain & Base URL
# ------------------------------------------------------------------------------
APP_DOMAIN=no5ocial.vercel.app
WEB_BASE_URL=https://no5ocial.vercel.app

