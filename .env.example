# ==============================================================================
# no5ocial Root / Frontend Environment Configuration Template
#
# SECURITY INSTRUCTION:
# 1. Copy this file to `.env` (which is ignored by .gitignore).
# 2. Never commit real secrets, private keys, or tokens to version control.
# 3. Use `--dart-define-from-file=.env` or `--dart-define=KEY=VALUE` when running Flutter.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client IDs
# ------------------------------------------------------------------------------
# Web Client ID (Registered in Google Cloud Console as Web Application)
# Required for Flutter Web & as serverClientId on Android for backend token exchange.
GOOGLE_WEB_CLIENT_ID=1030532523858-o2o0l8c04r7jqdqn8d36ulkafonfafui.apps.googleusercontent.com

# Android Client ID (Registered in Google Cloud Console as Android)
# Tied to package: com.shaadow.no5ocial and your keystore SHA-1.
GOOGLE_ANDROID_CLIENT_ID=1030532523858-cclggq2pqcuqdntibtvt7mmftsoqie2a.apps.googleusercontent.com

# Generic alias fallback
GOOGLE_CLIENT_ID=1030532523858-o2o0l8c04r7jqdqn8d36ulkafonfafui.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8080
