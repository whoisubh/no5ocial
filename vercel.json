{
  "cleanUrls": true,
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/legal/privacy",
      "destination": "/legal/privacy/index.html"
    },
    {
      "source": "/legal/privacy/",
      "destination": "/legal/privacy/index.html"
    },
    {
      "source": "/legal/terms",
      "destination": "/legal/terms/index.html"
    },
    {
      "source": "/legal/terms/",
      "destination": "/legal/terms/index.html"
    },
    {
      "source": "/legal/disclaimer",
      "destination": "/legal/disclaimer/index.html"
    },
    {
      "source": "/legal/disclaimer/",
      "destination": "/legal/disclaimer/index.html"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/assetlinks"
    },
    {
      "source": "/api/auth/:platform/start",
      "destination": "/api/auth/start?platform=:platform"
    },
    {
      "source": "/api/auth/callback/:platform",
      "destination": "/api/auth/callback?platform=:platform"
    },
    {
      "source": "/api/youtube/:action",
      "destination": "/api/youtube?action=:action"
    },
    {
      "source": "/api/media",
      "destination": "/api/media"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index"
    }
  ]
}
